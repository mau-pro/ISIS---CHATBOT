# Clave secreta para firmar tokens JWT (generar una propia y larga en producción)
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# API key de Groq
GROQ_API_KEY=tu_api_key_de_groq

# Credenciales de la cuenta admin sembrada por seed_admin.py
ADMIN_EMAIL=admin@universidad.edu
ADMIN_PASSWORD=cambia-esta-contrasena
# Nombre de usuario con el que el admin inicia sesión (opcional; si falta, se usa la parte del correo antes de la @)
ADMIN_USERNAME=admin

# Límites de uso (peticiones por minuto)
RATE_LIMIT_ESTUDIANTE=30/hour

# Envío de correos de verificación (usando Gmail SMTP como ejemplo)
# SMTP_USER es tu correo de Gmail, SMTP_PASSWORD es una "contraseña de aplicación"
# (NO tu contraseña normal): generarla en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion

# URLs usadas para armar el link de verificación que se envía por correo
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Modelos de Groq a usar, en orden (si uno agota su cupo se pasa al siguiente). Por defecto: gpt-oss-120b, qwen/qwen3.8-27b, gpt-oss-20b
# MODELOS_IA=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
