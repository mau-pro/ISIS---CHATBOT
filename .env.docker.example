# Variables de docker-compose. Copiá este archivo a ".env" (en esta misma carpeta) y completalo.
# No se sube a GitHub.

# Contraseña de la base PostgreSQL interna (solo letras y números, 16+ caracteres)
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# Dirección pública del sistema, sin barra final. Se usa en los enlaces de los correos.
# En tu PC:  http://localhost      En un servidor:  https://isis.midominio.edu.bo
PUBLIC_URL=http://localhost
